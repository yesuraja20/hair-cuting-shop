# AUREUS & BLADE - ENVIRONMENT VARIABLES EXAMPLE
# Copy this file or paste these values into config.js / Admin Panel Settings

# Supabase Project Credentials
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Payment Gateway (Razorpay or Stripe)
# For Razorpay: Create free test account at dashboard.razorpay.com -> Settings -> API Keys
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_GATEWAY_KEY_ID=rzp_test_your_key_id_here
PAYMENT_GATEWAY_MODE=test
PAYMENT_CURRENCY=USD

# Admin Access Credentials
ADMIN_EMAIL=admin@aureusblade.com
ADMIN_PASSWORD=admin
